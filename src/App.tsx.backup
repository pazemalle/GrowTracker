import React from 'react';
import { BrowserRouter as Router, Routes, Route, Link, useLocation } from 'react-router-dom';
import { StoreProvider } from './context/StoreContext';
import { LanguageProvider } from './context/LanguageContext';
import { AuthProvider } from './context/AuthContext';
import { LayoutDashboard, Sprout, Settings, PlusCircle } from 'lucide-react';
import { Dashboard } from './components/Dashboard';
import { Profiles } from './components/Profiles';
import { NewGrow } from './components/NewGrow';
import { GrowDetail } from './components/GrowDetail';
import { SettingsPage } from './components/Settings';
import { useLanguage } from './context/LanguageContext';
import { useAuth } from './context/AuthContext';
import { useStore } from './context/StoreContext';

const Navigation = () => {
  const location = useLocation();
  const { t } = useLanguage();

  // Get auth and store state for storage badge
  let isAuthenticated = false;
  let grows: any[] = [];
  let profiles: any[] = [];

  try {
    const auth = useAuth();
    const store = useStore();
    isAuthenticated = auth.isAuthenticated;
    grows = store.grows;
    profiles = store.profiles;
  } catch {
    // Contexts not available
  }

  const isActive = (path: string) => location.pathname === path;

  return (
    <nav className="app-navigation">
      <div className="nav-container">
        {/* App Title - Desktop Only */}
        <div className="nav-header">
          <h1 className="nav-title">
            <div className="nav-icon-wrapper">
              <Sprout className="nav-icon" size={26} />
            </div>
            <span className="gradient-text">{t.nav.appTitle}</span>
          </h1>
          <p className="nav-subtitle">{t.nav.appSubtitle}</p>
        </div>

        {/* Navigation Links */}
        <Link to="/" className={`nav-link ${isActive('/') ? 'nav-link-active' : ''}`}>
          <div className="nav-link-content">
            <LayoutDashboard size={22} className="nav-link-icon" />
            <span className="nav-link-text">{t.nav.dashboard}</span>
          </div>
          {isActive('/') && <div className="nav-link-glow" />}
        </Link>

        <Link to="/profiles" className={`nav-link ${isActive('/profiles') ? 'nav-link-active' : ''}`}>
          <div className="nav-link-content">
            <Settings size={22} className="nav-link-icon" />
            <span className="nav-link-text">{t.nav.profiles}</span>
          </div>
          {isActive('/profiles') && <div className="nav-link-glow" />}
        </Link>

        <Link to="/new-grow" className={`nav-link ${isActive('/new-grow') ? 'nav-link-active' : ''}`}>
          <div className="nav-link-content">
            <PlusCircle size={22} className="nav-link-icon" />
            <span className="nav-link-text">{t.nav.newGrow}</span>
          </div>
          {isActive('/new-grow') && <div className="nav-link-glow" />}
        </Link>

        <Link to="/settings" className={`nav-link ${isActive('/settings') ? 'nav-link-active' : ''}`}>
          <div className="nav-link-content">
            <Settings size={22} className="nav-link-icon" />
            <span className="nav-link-text">{t.nav.settings}</span>
          </div>
          {isActive('/settings') && <div className="nav-link-glow" />}
        </Link>

        {/* Storage Mode Badge - Bottom */}
        <div className="mt-auto pt-4 border-t border-slate-800">
          {isAuthenticated ? (
            grows.length > 0 || profiles.length > 0 ? (
              <div
                className="text-xs px-3 py-2 rounded bg-blue-900/30 border border-blue-500/30 text-blue-300 cursor-help transition-all hover:bg-blue-900/50"
                title={t.nav.storageBadgeHybridTooltip}
              >
                🔄 {t.nav.storageBadgeHybrid}
              </div>
            ) : (
              <div
                className="text-xs px-3 py-2 rounded bg-emerald-900/30 border border-emerald-500/30 text-emerald-300 cursor-help transition-all hover:bg-emerald-900/50"
                title={t.nav.storageBadgeServerTooltip}
              >
                ✅ {t.nav.storageBadgeServer}
              </div>
            )
          ) : (
            <div
              className="text-xs px-3 py-2 rounded bg-yellow-900/30 border border-yellow-500/30 text-yellow-300 cursor-help transition-all hover:bg-yellow-900/50"
              title={t.nav.storageBadgeGuestTooltip}
            >
              ⚠️ {t.nav.storageBadgeGuest}
            </div>
          )}
        </div>
      </div>
    </nav>
  );
};

const AppContent: React.FC = () => {
  return (
    <div className="min-h-screen bg-slate-950 text-slate-100 flex flex-col md:flex-row">
      <Navigation />
      <main className="app-main">
        <div className="container mx-auto p-4 md:p-8 max-w-5xl">
          <Routes>
            <Route path="/" element={<Dashboard />} />
            <Route path="/profiles" element={<Profiles />} />
            <Route path="/new-grow" element={<NewGrow />} />
            <Route path="/grow/:id" element={<GrowDetail />} />
            <Route path="/settings" element={<SettingsPage />} />
          </Routes>
        </div>
      </main>
    </div>
  );
};

const App: React.FC = () => {
  return (
    <LanguageProvider>
      <AuthProvider>
        <StoreProvider>
          <Router>
            <AppContent />
          </Router>
        </StoreProvider>
      </AuthProvider>
    </LanguageProvider>
  );
};

export default App;
